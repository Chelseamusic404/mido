mid = MidiFile()
track = MidiTrack()
mid.tracks.append(track)

# Set instrument (e.g., piano)
track.append(Message('program_change', program=0, time=0))

# Define tempo and note duration
tempo = 500000  # Moderate ballad tempo
note_duration = 480  # Quarter note

# Melody sequence
melody_notes = [
    (60, 1), (62, 1), (64, 1), (65, 1), (67, 1),  # Intro
    (69, 1), (67, 1), (65, 1), (64, 1), (62, 1),  # Downward progression
    (60, 1), (62, 1), (64, 1), (65, 1), (67, 1),  # Verse start
    (69, 1), (71, 1), (72, 2), (71, 1), (69, 1),  # Emotional depth
    (67, 1), (65, 1), (64, 2), (62, 1), (60, 1),  # Resolving phrase
]

# Chord sequence (simple triads)
chord_notes = [
    [48, 52, 55],  # C major
    [50, 53, 57],  # D minor
    [52, 55, 59],  # E minor
    [53, 57, 60],  # F major
    [55, 59, 62],  # G major
]

# Add melody and chords to the track
for i, (note, duration) in enumerate(melody_notes):
    # Add melody note
    track.append(Message('note_on', note=note, velocity=64, time=0))
    track.append(Message('note_off', note=note, velocity=64, time=note_duration * duration))

    # Add chord notes (every 2 melody notes)
    if i % 2 == 0:
        chord = chord_notes[i % len(chord_notes)]
        for chord_note in chord:
            track.append(Message('note_on', note=chord_note, velocity=48, time=0))
            track.append(Message('note_off', note=chord_note, velocity=48, time=note_duration * duration))

# Save MIDI file
midi_path = "romantic_ballad_with_chords.mid"
mid.save(midi_path)

print(f"MIDI file saved to {midi_path}")
